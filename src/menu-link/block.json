{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "soli/menu-link",
	"version": "0.1.0",
	"title": "Menu Link",
	"category": "widgets",
	"icon": "admin-links",
	"description": "For displaying a single link in the soli mega menu.",
	"example": {},
	"supports": {
      "html": false,
      "typography": {
        "fontSize": true,
        "lineHeight": true,
        "fontStyle": true,
        "fontWeight": true,
        "textTransform": true,
        "letterSpacing": true
      },
      "color": {
        "text": true
      }
	},
    "attributes": {
      "tagName": { "type": "string", "default": "a" },
      "linkType": { "type": "string", "default": "page" },
      "postId": { "type": "integer", "default": 0 },
      "postType": { "type": "string", "default": "page" },
      "url": { "type": "string", "default": "" },
      "label": { "type": "string", "default": "" },
      "opensInNewTab": { "type": "boolean", "default": false }
    },
	"textdomain": "soli",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
    "render": "file:./render.php"
}